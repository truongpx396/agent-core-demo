# The development entry of the front door (docker-compose.yml, profile `gateway`; specs/017 and specs/018). Development only: `tls internal` has
# Caddy sign the certificates with its own local CA (`make mcp-gateway-ca` exports the root so a client can trust it), the names are *.localhost
# (they resolve to the loopback address with no /etc/hosts entry), and one port serves all three so that an issuer or a resource URL written in a
# token matches what the client dialled.
#
# The routing is gateway.caddy's, the same file production's Caddyfile imports: this file says how each site is addressed and certified and what
# sits behind it, and nothing else.
{
	# Nothing listens on 80, so there is nothing to redirect from.
	auto_https disable_redirects
}

# What sits behind the API's check: the stub that echoes what it received (`authlimit-echo:8000`, the default, which is how `make authlimit-smoke`
# sees exactly what a real API would have been given) or the API itself (`api:8000`, which is what `make authlimit-up-app` sets, with the API in
# identity mode so it trusts only the identity this door adds). {$AUTHLIMIT_UPSTREAM} is resolved by compose's `:-`, because Caddy's own default
# only fires on an UNSET variable, not an empty one.
(api_proxy) {
	reverse_proxy {$AUTHLIMIT_UPSTREAM:authlimit-echo:8000} {
		flush_interval -1
	}
}

# The Telegram bot's own listener. In development the bot runs on the host (`make telegram`) and listens on TELEGRAM_LISTEN_PORT (default 8081);
# it binds loopback unless TELEGRAM_LISTEN_HOST=0.0.0.0, which a container reaching it as host.docker.internal needs.
(telegram_proxy) {
	reverse_proxy host.docker.internal:8081
}

import gateway.caddy

https://mcp.localhost:8443 {
	tls internal
	import mcp_site
}

https://api.localhost:8443 {
	tls internal
	import api_site
}

https://auth.localhost:8443 {
	tls internal
	import auth_site
}
