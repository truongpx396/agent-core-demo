# Template for /opt/graph-agent-core/.env on the droplet — copy this there
# and fill in real values ONCE, by hand, over SSH (deploy/README.md's
# first-time-setup section). Never committed with real values, and never
# written or touched by .github/workflows/deploy.yml: that workflow only
# ships code/compose/config, deliberately not secrets (see
# docker-compose.prod.yml's own header comment).

# --- Container images (.github/workflows/deploy.yml builds+pushes these
# to GHCR; IMAGE_TAG itself is passed by that workflow at deploy time, not
# stored here) — lowercase, must match your actual GitHub org/user + repo. ---
APP_IMAGE=ghcr.io/your-gh-username/graph-agent-core
ML_IMAGE=ghcr.io/your-gh-username/graph-agent-core-ml-service
AUTHLIMIT_IMAGE=ghcr.io/your-gh-username/graph-agent-core-authlimit

# --- Postgres (shared by litellm/checkpointer/appdata — see
# docker-compose.prod.yml's postgres service comment on why the username
# stays "langfuse") ---
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- LiteLLM proxy ---
# Generate: openssl rand -hex 24 (or -hex 32) — this becomes the value
# app callers must send as OPENAI_API_KEY; app/adapters/inbound/api and the workers get it
# automatically via docker-compose.prod.yml's *app-env anchor.
LITELLM_MASTER_KEY=
# The key the APP sends, scoped and budget-capped, so the app never holds gateway admin
# credentials and the gateway can stop runaway spend even if every app-side ceiling fails.
# Leave empty on the very first deploy (LiteLLM has to be up to mint it), then:
#   LITELLM_MASTER_KEY=... python -m scripts.tools.litellm_key create --max-budget <usd per 30 days>
# and paste the key it prints here. Until you do, the app falls back to the master key.
LITELLM_APP_KEY=
LITELLM_UI_USERNAME=admin
# Generate: openssl rand -hex 16
LITELLM_UI_PASSWORD=

# --- Upstream LLM (litellm-config.prod.yaml) — any OpenAI-compatible
# endpoint. Example below targets OpenAI directly; swap for Anthropic's
# OpenAI-compatible endpoint, a hosted vLLM/Ollama instance, etc. ---
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=openai/gpt-4o-mini
LLM_EMBED_MODEL=openai/text-embedding-3-small
# Optional: the middle tier (the `chat-medium` alias; `chat` is the easy tier, `chat-strong` the strong one). LEAVE UNSET and it is the same as
# the chat model above. Nothing selects it automatically: a delegated specialist names it in its AGENT.md `model:`, or you point CHAT_MODEL at it.
# To attach Gemini through Google's OpenAI-compatibility endpoint (beta, per Google), set all three, state the price in litellm-config.prod.yaml
# (LiteLLM does not know an `openai/<gemini id>`, and UNPRICED_MODEL_POLICY=block refuses an unpriced one), restart the proxy, then check it:
# `make probe-tools ARGS="--alias chat-medium"`. Use a different key for each tier if you want each capped on its own in Google's console.
# LLM_MEDIUM_CHAT_MODEL=openai/<a Gemini flash-class model id>
# LLM_MEDIUM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MEDIUM_API_KEY=
# Optional: the stronger model the router may escalate a turn to (the `chat-strong` alias; specs/014). LEAVE UNSET and it is the same as the
# chat model above, so nothing changes. To attach a stronger one, set all three (any OpenAI-compatible endpoint with native tool calls), restart
# the proxy, then set STRONG_CHAT_MODEL=chat-strong and ROUTER_MODE=shadow (then on) for the app. If LiteLLM does not know the model's price, state it
# in litellm-config.prod.yaml (model_info) before using UNPRICED_MODEL_POLICY=block.
# LLM_STRONG_CHAT_MODEL=
# LLM_STRONG_API_BASE=
# LLM_STRONG_API_KEY=

# --- Object storage — DigitalOcean Spaces by default (S3-compatible; see
# docker-compose.prod.yml's header on why no self-hosted MinIO container
# runs here). Create a Space + access key at
# https://cloud.digitalocean.com/spaces ---
MINIO_ENDPOINT=nyc3.digitaloceanspaces.com
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=graph-agent-core-uploads
MINIO_SECURE=true

# --- The front door: three public names, REQUIRED (deploy/caddy/Caddyfile, docker-compose.prod.yml). Identity needs an https issuer, so there is
# no plain-HTTP fallback and no default: compose refuses to start without them. Point an A/AAAA record for each at the droplet's reserved IP first
# (deploy/README.md, "Point DNS at them"); Caddy then gets a Let's Encrypt certificate for each on first use.
#   API_DOMAIN   the chat API and the web page; the audience of every token
#   AUTH_DOMAIN  Casdoor; the issuer of every token, where people sign in
#   MCP_DOMAIN   the MCP gateway's read-only tools
API_DOMAIN=api.your-domain.example.com
AUTH_DOMAIN=auth.your-domain.example.com
MCP_DOMAIN=mcp.your-domain.example.com

# --- Casdoor, the authorization server (docker-compose.prod.yml's `casdoor`, with its own Postgres). Both are required. Generate each: openssl rand -hex 24
# The admin password is the `built-in` organization's `admin`, whose login is on AUTH_DOMAIN: treat it as the keys to every tenant. The first
# sign-in, tenants and users are created once, by hand (deploy/README.md, "Create the tenants and sign-in clients").
CASDOOR_DB_PASSWORD=
CASDOOR_ADMIN_PASSWORD=

# --- authlimit's signing keys: a host directory OUTSIDE the repo and the image, mode 700, owned by uid 65532, made once (deploy/README.md). The default
# is where the runbook makes it; set this only to put it elsewhere.
# AUTHLIMIT_KEYS_DIR=/opt/graph-agent-core/authlimit-keys
# `enforce` (the default) refuses over-limit requests with a 429; `observe` serves them and counts what it would have refused, for sizing a new limit.
# AUTHLIMIT_LIMIT_MODE=enforce
# The MCP gateway's ops tools read a Prometheus; the observability droplet's is not reachable from here by default, so point this at one that is.
# MCP_GATEWAY_PROMETHEUS_URL=
# MCP_GATEWAY_OPS_TENANTS=ops-team

# --- Observability droplet (docker-compose.prod.yml's otel-collector-agent/
# promtail services) — the SEPARATE, smaller droplet deploy/terraform
# provisions (digitalocean_droplet.observability). Get the value from
# `terraform output observability_private_ipv4` after `terraform apply`;
# it's a private DO VPC IP, never reachable from the public internet, so
# these are safe to leave unencrypted. Leaving either empty just means this
# droplet's metrics/logs have nowhere to go — the app itself is unaffected. ---
OBS_COLLECTOR_ENDPOINT=http://<observability_private_ipv4>:4318
LOKI_PUSH_HOST=<observability_private_ipv4>:3100
# Continuous profiling (specs/022): the observability droplet's Pyroscope, same private address. LEAVE EMPTY until the observability stack
# is up and 4040 is open on it (terraform firewall + ufw); empty means no profiling and nothing else changes. Not tried on a droplet yet.
PYROSCOPE_SERVER_ADDRESS=

# --- CORS — a real deployment narrows this from the dev default ("*");
# set it to your actual frontend origin(s), comma-separated. The built-in web page is served from API_DOMAIN. ---
CORS_ALLOWED_ORIGINS=https://api.your-domain.example.com

# --- Who is calling the API (specs/018 T069, pattern 98). Production runs in identity mode: the API trusts only the signed identity the authlimit front door adds
# to a request it verified. docker-compose.prod.yml sets AUTH_MODE=identity, AUTHLIMIT_KEYS_URL and the web page's WEB_AUTH_ISSUER and WEB_AUTH_AUDIENCE
# itself, derived from AUTH_DOMAIN and API_DOMAIN above, so they cannot disagree with what authlimit and Casdoor are started with: there is nothing
# to set here. NEVER set AUTH_MODE=headers on a deployment a stranger can reach (any client could claim any tenant); the alert ApiHeaderAuthMode
# fires if it is left on. ---

# --- Safety budgets — dev defaults are fine to start; see
# app/core/config.py for what each one means. Non-zero here (unlike the
# local Ollama stack) since LLM_API_BASE above is now a real paid
# provider. ---
MAX_COST_USD_PER_TURN=0.50
MAX_COST_USD_PER_TENANT_PER_DAY=20.0
# Starter values for the three optional limits (0 = off, which is what an unset line means):
# 20/day x 30 days is a $600 ceiling, so a $400 month turns a runaway tenant into a refusal
# well before the bill does; a $5 personal day stops one account from using a quarter of
# the tenant's day. Tune all three to what your pricing and users actually look like.
MAX_COST_USD_PER_TENANT_PER_MONTH=400.0
MAX_COST_USD_PER_PRINCIPAL_PER_DAY=5.0
MAX_COST_USD_PER_PRINCIPAL_PER_MONTH=100.0
# Every ceiling above multiplies tokens by a price LiteLLM supplies. A model it cannot
# price (a self-hosted vLLM, a fine-tune) would make them all read $0, so refuse to serve
# it until `model_info` costs are set in deploy/litellm/litellm-config.prod.yaml.
UNPRICED_MODEL_POLICY=block

# --- The domains the agent worker serves: comma-separated names, or `all` for ecorp, support, ops and sales. One process serves them all,
# under AGENT_WORKER_MAX_CONCURRENCY. Ecorp only by default; the other three are demo domains. ---
AGENT_WORKER_DOMAINS=ecorp

# --- Optional integrations — leave empty to skip (each degrades
# gracefully, see app/core/config.py's own comments per field) ---
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
# The Telegram bot is its own service and opt-in: `docker compose -f deploy/compose/docker-compose.prod.yml --profile telegram up -d` (the token above is
# its only required setting). `poll` (the default) needs no public address; `webhook` is served by Caddy at API_DOMAIN/telegram/webhook, so set
# TELEGRAM_WEBHOOK_URL=https://<API_DOMAIN>/telegram/webhook and a TELEGRAM_WEBHOOK_SECRET of 32 to 256 of A-Z a-z 0-9 _ -. Each Telegram user is a person
# `telegram-<id>` of TELEGRAM_TENANT, signed in with a password derived from TELEGRAM_PERSON_SECRET (at least 32 characters; required); or set
# TELEGRAM_LINKING=true and a TELEGRAM_LINK_KEY (a Fernet key) so people link their own account with /login. The agent worker must serve the bot's domain.
# TELEGRAM_MODE=poll
# TELEGRAM_WEBHOOK_URL=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_PERSON_SECRET=
# TELEGRAM_TENANT=ecorp
# TELEGRAM_AGENT_DOMAIN=ecorp
# TELEGRAM_LINKING=false
# TELEGRAM_LINK_KEY=
CRAWL4AI_SERVER_URL=
CRAWL4AI_API_TOKEN=
SERPER_API_KEY=
OPENSANDBOX_MCP_DOMAIN=
OPENSANDBOX_API_KEY=
