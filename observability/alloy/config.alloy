// Grafana Alloy — replaces this app droplet's otel-collector-agent +
// promtail sidecars with ONE process (docker-compose.prod.yml's `alloy`
// service). Alloy embeds the same OTel Collector receiver/processor/
// exporter components those two used separately, plus native Docker log
// discovery + Loki writing that vanilla OTel Collector has no equivalent
// for (that's why this app ran a separate Promtail before). Same two
// cross-droplet ports as before (OTLP to OBS_COLLECTOR_ENDPOINT, Loki push
// to LOKI_PUSH_HOST — both from this droplet's own .env) reaching the
// SAME, unchanged gateway on the observability droplet
// (docker-compose.observability.prod.yml's own `otel-collector` +
// `loki`) — only the producer side changed, not the wire format.
//
// This file was built by validating each piece against the real `alloy`
// binary (`alloy convert -f promtail`/`-f otelcol`, then `alloy validate`/
// `alloy fmt` on the merged result) rather than hand-guessing the
// component composition — Alloy's config language is easy to get subtly
// wrong from memory (e.g. `otelcol.receiver.prometheus` takes no
// scrape_configs of its own; scraping happens via `prometheus.scrape`
// bridged in via its `.receiver` export).
//
// Qdrant's and LiteLLM's own internal /metrics are NOT scraped here yet —
// deliberately deferred, same as before this file existed: those two
// ports also carry each service's full API, so scraping them needs its
// own tradeoff discussion, not a default-on add. Add a second
// `prometheus.scrape` here (targets: qdrant:6333, litellm:4000) forwarding
// into the same `otelcol.receiver.prometheus.default.receiver` if/when
// that's decided.

logging {
	level = "warn"
}

// --- Metrics: OTLP (api/agent-worker/ingest-worker's own app/core/metrics.py
// output) + a Prometheus bridge (node-exporter/cadvisor, feeding Stage 1's
// cpus:/mem_limit: sizing) -> batch -> forward to the gateway collector.
otelcol.receiver.otlp "default" {
	grpc { }

	http { }

	output {
		metrics = [otelcol.processor.batch.default.input]
	}
}

prometheus.scrape "node_exporter" {
	targets    = [{"__address__" = "node-exporter:9100"}]
	forward_to = [otelcol.receiver.prometheus.default.receiver]
}

prometheus.scrape "cadvisor" {
	targets    = [{"__address__" = "cadvisor:8080"}]
	forward_to = [otelcol.receiver.prometheus.default.receiver]
}

otelcol.receiver.prometheus "default" {
	output {
		metrics = [otelcol.processor.batch.default.input]
	}
}

otelcol.processor.batch "default" {
	timeout = "5s"

	output {
		metrics = [otelcol.exporter.otlphttp.gateway.input]
	}
}

otelcol.exporter.otlphttp "gateway" {
	client {
		endpoint = sys.env("OBS_COLLECTOR_ENDPOINT")
	}
}

// --- Logs: this droplet's own containers -> Loki push on the observability
// droplet. Same service-name allowlist as the old promtail-config.prod.yaml
// (structlog JSON from api/agent-worker/ingest-worker gets level/logger
// pulled into real Loki labels; litellm/postgres/redis/qdrant log plain
// text and just skip that stage harmlessly).
discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "^(api|agent-worker|ingest-worker|litellm|postgres|redis|qdrant)$"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		target_label  = "compose_project"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "compose_service"
	}
}

loki.source.docker "containers" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.containers.targets
	forward_to    = [loki.process.containers.receiver]
	relabel_rules = discovery.relabel.containers.rules
}

loki.process "containers" {
	forward_to = [loki.write.gateway.receiver]

	stage.json {
		expressions = {
			level  = "level",
			logger = "logger",
		}
	}

	stage.labels {
		values = {
			level  = null,
			logger = null,
		}
	}
}

loki.write "gateway" {
	endpoint {
		url = "http://" + sys.env("LOKI_PUSH_HOST") + "/loki/api/v1/push"
	}
}
