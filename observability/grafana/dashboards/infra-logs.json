    {
      "type": "logs",
      "title": "Warnings & errors across all services",
      "description": "Every container's stdout, parsed as JSON where possible (app/core/logging_config.py's structlog output) \u2014 see ../promtail/promtail-config.yaml.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"docker\"} | json | level=~\"error|warn\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
