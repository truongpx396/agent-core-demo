{
  "title": "Agent Core Logs",
  "uid": "agent-core-logs",
  "description": "Cross-service Loki log view (api, agent-worker × domain, ingest-worker, and every other container Promtail scrapes), filterable by service and level.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "agent-core-demo"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Agent Core Infra →",
      "tooltip": "",
      "type": "link",
      "url": "/d/agent-core-infra-logs"
    },
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Redis Top 15 →",
      "tooltip": "",
      "type": "link",
      "url": "/d/agent-core-redis-top10"
    },
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Postgres Top 15 →",
      "tooltip": "",
      "type": "link",
      "url": "/d/agent-core-postgres-top10"
    },
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Docker & System →",
      "tooltip": "",
      "type": "link",
      "url": "/d/BiigkBu7k"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values(compose_service)",
        "query": {
          "type": 1,
          "label": "compose_service",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false,
        "regex": ""
      },
      {
        "name": "level",
        "label": "Level",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values(level)",
        "query": {
          "type": 1,
          "label": "level",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "error",
            "warn"
          ],
          "value": [
            "error",
            "warn"
          ]
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false,
        "regex": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Logs (Loki)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "logs",
      "title": "Logs — filter by $service / $level",
      "description": "Every container's stdout, parsed as JSON where possible (app/core/logging_config.py's structlog output) — see ../promtail/promtail-config.yaml. Use the Service/Level dropdowns above to filter; defaults to error+warn across all services.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{compose_service=~\"$service\"} | json | level=~\"$level\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending"
      },
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 2
    }
  ]
}
