    {
      "type": "timeseries",
      "title": "Cache hit rate",
      "description": "rate(keyspace_hits) / rate(keyspace_hits + keyspace_misses) — the core signal for whether Redis is actually saving you round-trips to whatever it's caching in front of. Sustained drops usually mean a cache-key or TTL regression upstream, not a Redis problem.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * rate(redis_keyspace_hits_total[5m]) / (rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m]))",
          "legendFormat": "hit rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
