  "panels": [
    {
      "type": "stat",
      "title": "Up",
      "description": "pg_up — 1 if the exporter's last scrape reached Postgres, 0 otherwise. The single most basic health signal.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "pg_up",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
