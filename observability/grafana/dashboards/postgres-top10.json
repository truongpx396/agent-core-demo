    {
      "type": "timeseries",
      "title": "Rollback ratio",
      "description": "100 * rollbacks/sec / (commits/sec + rollbacks/sec), broken out per database — the share of transactions the application is aborting. A rising ratio points at app-level errors, constraint violations, or retry storms, not a Postgres problem per se; splitting by database points at which app is doing the aborting.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum by (datname) (rate(pg_stat_database_xact_rollback{datname=~\"$database\"}[5m])) / (sum by (datname) (rate(pg_stat_database_xact_commit{datname=~\"$database\"}[5m])) + sum by (datname) (rate(pg_stat_database_xact_rollback{datname=~\"$database\"}[5m])))",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
