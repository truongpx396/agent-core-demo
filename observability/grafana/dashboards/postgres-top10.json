    {
      "type": "timeseries",
      "title": "Cache hit ratio",
      "description": "100 * sum(blks_hit) / (sum(blks_hit) + sum(blks_read)), broken out per database — the single most-watched Postgres health number: the share of block reads served from shared_buffers instead of disk. Sustained drops below ~99% usually mean shared_buffers is too small for that database's working set, not a query problem. Splitting by database (rather than one blended number) is what actually lets you tell which database is the one under memory pressure.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum by (datname) (pg_stat_database_blks_hit{datname=~\"$database\"}) / (sum by (datname) (pg_stat_database_blks_hit{datname=~\"$database\"}) + sum by (datname) (pg_stat_database_blks_read{datname=~\"$database\"}))",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
