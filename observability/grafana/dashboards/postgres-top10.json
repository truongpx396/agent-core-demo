    {
      "type": "timeseries",
      "title": "Deadlocks/sec",
      "description": "sum(rate(pg_stat_database_deadlocks[5m])), broken out per database — transactions Postgres killed to break a lock cycle. Any sustained value above 0 means real application contention, not a tuning nit; splitting by database points straight at which app is fighting itself.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (rate(pg_stat_database_deadlocks{datname=~\"$database\"}[5m]))",
          "legendFormat": "{{datname}}",
          "refId": "A"
