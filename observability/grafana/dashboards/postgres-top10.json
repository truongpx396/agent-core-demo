    {
      "type": "timeseries",
      "title": "Longest open transaction",
      "description": "max(pg_stat_activity_max_tx_duration) split by database and session state. A climbing \"active\" value usually means a slow query; a climbing \"idle in transaction\" value means a client opened a transaction and stopped talking to Postgres without committing/rolling back — both hold locks and block autovacuum from reclaiming dead rows. Split by database since this is fundamentally a \"which app is stuck\" panel.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (datname) (pg_stat_activity_max_tx_duration{state=\"active\", datname=~\"$database\"})",
          "legendFormat": "{{datname}} active",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (datname) (pg_stat_activity_max_tx_duration{state=\"idle in transaction\", datname=~\"$database\"})",
          "legendFormat": "{{datname}} idle in transaction",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "stacking": {
              "mode": "none"
            },
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 16
    },
    {
      "type": "timeseries",
      "title": "Locks by mode",
      "description": "sum(pg_locks_count) by lock mode, scoped by the Database filter above — contention indicator. RowExclusiveLock is normal background noise from writes; sustained ExclusiveLock/AccessExclusiveLock (schema changes, full-table locks) or a climbing total across the board is what to actually watch for. Grouped by mode rather than mode+database to keep this readable — narrow with the Database dropdown instead of adding another dimension to the legend.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (mode) (pg_locks_count{datname=~\"$database\"})",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            },
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi"
        }
