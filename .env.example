# --- LLM access (everything goes through the LiteLLM proxy) ---
# The proxy speaks the OpenAI API, so we just point the OpenAI client at it.
OPENAI_API_BASE=http://localhost:4000/v1
OPENAI_API_KEY=sk-anything          # LiteLLM master key; any value works locally

CHAT_MODEL=chat                     # model *alias* defined in litellm-config.yaml
EMBED_MODEL=embed                   # embedding alias defined in litellm-config.yaml

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
COLLECTION=docs

# --- Langfuse (get these keys from the Langfuse UI after `make up`) ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
