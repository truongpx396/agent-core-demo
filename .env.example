# --- LLM access (everything goes through the LiteLLM proxy) ---
# The proxy speaks the OpenAI API, so we just point the OpenAI client at it.
OPENAI_API_BASE=http://localhost:4000/v1
OPENAI_API_KEY=sk-anything          # the key a HOST process (`make serve`, `make agent-worker`) sends to LiteLLM; the master key unless you mint a scoped one
# The same thing for the CONTAINERIZED app (`make up-app`): a container does not read OPENAI_API_KEY above, so the compose file takes THIS
# variable (from `.env` or your shell) and hands it to the api and the workers as their OPENAI_API_KEY. Mint a scoped, budget-capped key with
# `LITELLM_MASTER_KEY=... make litellm-key ARGS="create --max-budget <usd> --budget-duration 1d"` (printed once), then set BOTH names to it if you
# run host processes and containers side by side. Unset, the containers use the dev master key (sk-anything). Same name as the prod compose.
# LITELLM_APP_KEY=

CHAT_MODEL=chat                     # model *alias* defined in litellm-config.yaml
# Send the tools to the chat model as OpenAI strict-mode schemas (every argument required, optional ones nullable, objects closed). Leave it false
# on the local Ollama path: Ollama ignores it, and the smallest model measurably calls tools worse with it (GRAPH_PATTERNS.md pattern 74). Set true
# together with pointing the chat alias at a provider that enforces strict function calling, and run `make probe-tools` before and after.
# TOOL_CALLS_STRICT=false
EMBED_MODEL=embed                   # embedding alias defined in litellm-config.yaml
# The hosted tiers' keys, read by the LiteLLM container (not the app) once you replace the local `chat-medium` / `chat-strong` stand-ins in
# deploy/litellm/litellm-config.yaml with their Gemini blocks (README, "Model tiers"). Use a separate key for each tier.
# GEMINI_API_KEY_MEDIUM=
# GEMINI_API_KEY_STRONG=
# Task prefixes the embedding model needs (specs/014). Empty = today's behavior. nomic-embed-text's card says its input "must include"
# the prefix `search_query: ` for a question and `search_document: ` for a stored passage (quote the value in .env to keep the
# trailing space); the app has never sent them. TURNING ONE ON CHANGES THE EMBEDDING SPACE: every collection must be rebuilt first
# (`make reembed COLLECTION_NAME=...`) or retrieval is refused as an identity mismatch. Decide with `make model-eval` (compare nomic with
# and without them), not by assumption.
# EMBED_QUERY_PREFIX=
# EMBED_DOCUMENT_PREFIX=
# Bump when you re-pull the embedding model under the same name (an Ollama tag moved): the alias resolver cannot see that.
# EMBED_MODEL_REVISION=
# EMBED_IDENTITY_CACHE_SECONDS=10.0   # how long a collection's identity check is cached

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
COLLECTION=docs

# --- Langfuse (get these keys from the Langfuse UI after `make up`) ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Seconds process exit waits for the tracing client to flush before giving up (a down Langfuse otherwise stalls exit ~90 s).
# LANGFUSE_SHUTDOWN_TIMEOUT_SECONDS=5

# --- Databases (two separate databases in the same Postgres the compose stack runs) ---
# The durable checkpointer holds graph state AND paused human-approval state, so
# a restart loses neither (GRAPH_PATTERNS.md pattern 16); the appdata database
# holds the usage ledger, tickets, CRM, incidents and tool-call idempotency keys.
# The defaults below are docker-compose's own credentials — set real ones in
# .env.prod. (An older CHECKPOINT_DB_PATH, a SQLite file, was removed: nothing
# reads it, the checkpointer is Postgres now.)
# CHECKPOINTER_DATABASE_URL=postgresql://langfuse:langfuse@localhost:5432/checkpointer
# APPDATA_DATABASE_URL=postgresql://langfuse:langfuse@localhost:5432/appdata
# CHECKPOINTER_POOL_MAX_SIZE=10       # raising it alone does not raise checkpoint throughput
#                                     # past one connection per process; add worker replicas

# --- Observability (app/core/telemetry.py) ---
# Where the API/agent-worker/ingest-worker push their OTel metrics via
# OTLP/HTTP. Only matters if you've also started the optional observability
# stack (`make obs-up`, docker-compose.observability.yml) — its
# otel-collector publishes this same port to the host. Safe to leave
# unset/unreachable otherwise: a failed push is just dropped.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Telegram channel (app/channels/telegram.py, `make telegram`) ---
# Create a bot via @BotFather in Telegram to get a token. Optional — the
# rest of the app runs fine with this unset; only `make telegram` needs it,
# and refuses to start without it (see GRAPH_PATTERNS.md pattern 42).
TELEGRAM_BOT_TOKEN=

# Which domain (app/domains/registry.py) app/channels/telegram.py boots
# against: ecorp (default), support, ops, or sales — see README.md's
# "Example domains" section. `make telegram-support`/`make telegram-sales`
# set this for you.
AGENT_DOMAIN=ecorp

# How many times an unattended caller (this channel has no approve/reject UX)
# auto-declines a mandatory-approval pause on ONE turn before the run is
# cancelled with an explicit "needs a person's approval" reply — see
# app/agent/runtime/stream.py::astream_events_turn_unattended and
# GRAPH_PATTERNS.md pattern 8. Optional; the default is 3.
# UNATTENDED_MAX_DECLINE_ROUNDS=3

# --- Ops bot (app/domains/ops/, `make ops-digest`) ---
# The Prometheus this repo's optional observability stack runs
# (docker-compose.observability.yml, `make obs-up`) — the ops bot's
# fetch_metrics_summary tool and scripts/ops_digest.py query it directly.
PROMETHEUS_URL=http://localhost:9090

# --- Team-channel notifications (app/domains/notify.py) ---
# Used by the ops bot's post_to_team_channel tool and the support/sales
# domains' escalate_to_human/handoff_to_human. Optional — unset falls back
# to a local var/team_channel.log sink; set this to also best-effort POST
# to a real Slack incoming webhook.
SLACK_WEBHOOK_URL=

# --- crawl4ai server (app/ingestion/web_crawler.py, docker-compose.yml's
# `crawl4ai` service — GRAPH_PATTERNS.md pattern 50) ---
# Required for the crawl4ai container to be reachable at all — without it
# the server binds loopback-only inside its own container (secure-by-default
# since crawl4ai 0.9.0+; the published port would just connection-reset).
# Generate: openssl rand -hex 32
CRAWL4AI_API_TOKEN=
# Where the crawl4ai container is reachable from this process (11235 is its real listen port).
# CRAWL4AI_SERVER_URL=http://localhost:11235

# --- OpenSandbox server (app/domains/sandbox_tools.py, docker-compose.yml's
# `opensandbox-server` service, `make sandbox-up` — GRAPH_PATTERNS.md
# pattern 50) ---
# Required — opensandbox-server refuses to start in non-interactive mode
# without an api_key. Generate: openssl rand -hex 32
OPENSANDBOX_API_KEY=
# host:port opensandbox-server listens on. 8090, not its packaged 8080 — open-webui
# already binds 8080 here, and a request landing on it looked like a real 405.
# OPENSANDBOX_MCP_DOMAIN=localhost:8090
# Image and lifetime of the one sandbox each conversation lazily creates and reuses.
# Build the image with `make sandbox-build`; bump both together if a deployment needs
# more packages or longer pauses between human approvals.
# SANDBOX_IMAGE=agent-core-demo-sandbox:latest
# SANDBOX_TTL_SECONDS=1800

# --- MCP servers this app PUBLISHES (app/mcp/server.py, ops_server.py; `make mcp-serve`, `make mcp-serve-ops`) ---
# Who the server acts for. Set by whoever LAUNCHES it, never passed as a tool argument: the assistant connected to a
# server fills the arguments in, so a tenant there is a tenant a prompt injection can name (GRAPH_PATTERNS.md pattern 21).
# For a desktop client, put the same two names in the `env` block of its server entry (README, "MCP, crawling and the sandbox").
# The server refuses to start without them; the operations server needs only the principal (its data is not tenant-scoped).
# MCP_TENANT=
# MCP_PRINCIPAL=

# --- The MCP gateway (app/mcp/gateway.py; specs/017; `make mcp-gateway-up`) ---
# The published servers over Streamable HTTP behind OAuth 2.1: the identity comes from a verified access token on every request
# (the tenant and principal claims below), not from MCP_TENANT/MCP_PRINCIPAL. A resource server only; the tokens come from the
# authorization server named here. Empty issuer or JWKS URL = the gateway refuses to start.
# The origin clients use (no path). Each server's audience is this + its path (/ecorp/mcp, /ops/mcp); also the only Host/Origin answered.
# MCP_GATEWAY_PUBLIC_URL=https://mcp.localhost:8443
# The authorization server's issuer exactly as it appears in a token's `iss` (e.g. https://auth.localhost:8443), and where to fetch its
# signing keys (e.g. http://casdoor:8000/.well-known/jwks: an in-network name inside Docker, which is why they are two settings).
# MCP_GATEWAY_ISSUER=
# MCP_GATEWAY_JWKS_URL=
# Which claims name the tenant and the principal (Casdoor: `owner` is the organization, `sub` a stable user id).
# MCP_GATEWAY_TENANT_CLAIM=owner
# MCP_GATEWAY_PRINCIPAL_CLAIM=sub
# Tenants allowed on the operations server (comma-separated). Its data is the deployment's, not a tenant's; empty = nobody.
# MCP_GATEWAY_OPS_TENANTS=
# Seconds the signing keys are cached (a rotated key is fetched on the next unknown `kid` anyway).
# MCP_GATEWAY_JWKS_CACHE_SECONDS=300

# --- Bounds on what a tool hands the model (app/core/output_limits.py; specs/009 A3) ---
# The most text one remote MCP tool call, or one sandbox result, may return: the head and tail are kept and the middle is
# replaced by a marker saying how much. 20,000 is the page reader's own cap, so no tool returns more than a crawled page can.
# MCP_TOOL_OUTPUT_MAX_CHARS=20000
# The longest command, script, path or file content the model may send a sandbox tool (a validation error names the limit).
# SANDBOX_ARG_MAX_CHARS=20000

# --- Gemini (promptfoo/*-redteam.yaml's redteam.provider, `make
# promptfoo-redteam`, .github/workflows/redteam.yml; ALSO
# tests/deepeval/conftest.py's deepeval_judge fixture, @pytest.mark.deepeval,
# `make deepeval` — the same key, shared by both since 2026-09-17) ---
# Needed for `make promptfoo-redteam` (and its scheduled CI counterpart)
# AND test_rag_quality_deepeval.py/test_tool_correctness_deepeval.py (the
# two deepeval files whose metrics never hit a Dict-typed judge schema —
# see GROQ_API_KEY below for the one that does) — in both cases the TARGET
# stays fully local/offline (PROMPTFOO_MODEL/DEEPEVAL_MODEL); only attack
# generation+grading (redteam.provider) and the deepeval JUDGE
# (DEEPEVAL_JUDGE_MODEL) are the deliberate exception — see
# promptfoo/redteam.yaml's own UPDATE paragraph and
# tests/deepeval/conftest.py's own DEEPEVAL_JUDGE_MODEL comment for why.
# deepeval's judge was Groq's `openai/gpt-oss-120b` for one day
# (2026-09-16) before moving here too (2026-09-17), once
# `gemini-3.1-flash-lite` proved to be the same right shape for these two
# files — one exception/one key instead of two, for THOSE files (see
# GROQ_API_KEY below for why test_conversation_simulator_deepeval.py
# couldn't follow). Get a key from https://aistudio.google.com/app/apikey
# — the free tier this was built against caps at 30 req/min, already
# accounted for by promptfoo-redteam's own --max-concurrency/--delay
# flags; the deepeval suite's own call volume (a couple of test files, not
# a redteam-scale sweep) stays comfortably under that with no extra pacing
# needed.
GOOGLE_API_KEY=

# --- Groq (tests/deepeval/conftest.py's deepeval_conversation_judge
# fixture, test_conversation_simulator_deepeval.py ONLY, `make deepeval`) ---
# Needed for exactly one of the three deepeval files — the other two use
# GOOGLE_API_KEY above instead. Real, structural reason, not a preference:
# this file's `KnowledgeRetentionMetric` requests a Dict-typed
# structured-output schema Gemini's response_schema flatly rejects (400
# INVALID_ARGUMENT on "additional_properties" — see
# tests/deepeval/conftest.py's own deepeval_conversation_judge docstring),
# for any Gemini model, so this one file stayed on Groq's
# `openai/gpt-oss-120b` rather than following the other two to Gemini.
# Used for BOTH of `judge`'s roles in that file: simulating the customer
# persona and grading the metrics. Get a key at
# https://console.groq.com/keys — real limits for this account/model, read
# directly off the API's own x-ratelimit-* response headers (not a blog
# post, and not the same shape reported for Gemini above): ~8,000 TPM, and
# 1,000 RPD — NOT RPM — that refills continuously (~0.69 req/min sustained
# once exhausted, confirmed by watching reset-requests grow +86.4s per
# call across 3 rapid requests: 86.4s * 1000 = 24h). Comfortably above
# this one file's own low call volume either way.
GROQ_API_KEY=

# --- deepeval judge failover (tests/deepeval/fallback.py, wired in
# tests/deepeval/conftest.py's `_with_fallbacks`: wraps BOTH deepeval_judge
# and deepeval_conversation_judge, `make deepeval`) ---
# Each judge answers through a chain: its primary, then OTHER MODELS ON THE
# SAME PROVIDER (same key, each with its own free-tier quota), then the
# optional backup providers below. A hand-over happens only on a rate limit,
# an overload or a timeout, judged by looking inside deepeval's own tenacity
# RetryError wrapper (the first version could not, so it never engaged).
# Both lists are comma-separated; `none` turns one off; unset or blank means
# the default shown, so nothing needs setting. Not secrets, so they are CI
# repo VARIABLES (see ci.yml's deepeval step), not repo secrets.
# DEEPEVAL_JUDGE_FALLBACK_MODELS=gemini-3.5-flash-lite
# DEEPEVAL_CONVERSATION_JUDGE_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b

# --- Backup judges: Plugsky, then OpenRouter (the LAST links of that chain, `make deepeval`;
# the registry is tests/deepeval/backup_providers.py) ---
# Optional — free, 100%-OpenAI-compatible backup judges, tried in this order
# AFTER the primary and the other models in the chain above are rate limited
# or overloaded past their own retry policy (GOOGLE_API_KEY or GROQ_API_KEY,
# depending on the file) — never a replacement for either key, and both
# fixtures behave exactly as before if neither key below is set. Each
# provider is enabled by its own key alone. A non-transient error (bad key,
# unknown or retired model id) stops the chain and fails loudly. Added
# proactively since both primaries' free tiers are real, finite ceilings
# (see the GOOGLE_API_KEY/GROQ_API_KEY comments above for the actual
# numbers) a busy `make deepeval` run could plausibly hit.
#
# 1) Plugsky — `plugsky-micro` (NVIDIA Nemotron 3 Super 120B), then
# `plugsky-lite`, the two models its free plan grants. Get a key at
# https://plugsky.com/dashboard. Caveat: its free plan's 30 req/min is
# documented per plan, not per model, so `plugsky-lite` only helps if that
# turns out to be per-model, or when `plugsky-micro`'s upstream is what's
# overloaded.
PLUGSKY_API_KEY=
# Ordered, comma-separated Plugsky model ids (a single id still works; this
# knob's original name, kept for existing .env files). Blank or unset means
# `plugsky-micro,plugsky-lite`; `none` switches Plugsky off even with a key.
# DEEPEVAL_BACKUP_MODEL=plugsky-micro,plugsky-lite
#
# 2) OpenRouter — `nvidia/nemotron-3-super-120b-a12b:free`, then
# `qwen/qwen3.8-27b:free`. Tried last because its free quota is the
# thinnest: OpenRouter limits `:free` models ACCOUNT-WIDE (20 req/min, and
# 50 requests/day — 1,000/day once the account has bought $10 of credits),
# so a second OpenRouter model adds a different upstream, not more quota,
# and 50/day can be exhausted by a single `make deepeval` run. Get a key at
# https://openrouter.ai/settings/keys.
OPENROUTER_API_KEY=
# Ordered, comma-separated OpenRouter model ids; blank or unset means the
# two above; `none` switches OpenRouter off even with a key. `:free` ids
# churn (some carry an expiration_date), and a retired id fails as a
# non-transient 404 — re-pick from https://openrouter.ai/models?variant=free.
# Keep it a large model: small ones are unreliable graders. `openrouter/free`
# (a router that picks a random free model per call) works but makes scores
# irreproducible.
# DEEPEVAL_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free,qwen/qwen3.8-27b:free

# --- DefectDojo (`make defectdojo-up`/`make defectdojo-import`,
# scripts/defectdojo_import.py — see README's "Security scanning & load
# testing") ---
# Only needed for `make defectdojo-import` (or CI's `zap` workflow's own
# optional import step) to push a scan report into a running DefectDojo
# instance. DEFECTDOJO_URL defaults to http://localhost:8080 (`make
# defectdojo-up`'s own port) if left unset. Generate DEFECTDOJO_API_KEY from
# the DefectDojo UI: My Account -> API v2 Key, after logging in with the
# admin password `make defectdojo-up` prints on first run.
DEFECTDOJO_URL=http://localhost:8080
DEFECTDOJO_API_KEY=

# =====================================================================
# Optional tunables — every one has the default shown; uncomment to change.
# Each is a field of app/core/config.py's Settings, whose comments carry the
# full reasoning. tests/core/test_env_example_matches_settings.py fails if a
# setting is missing from this file.
# =====================================================================

# --- Retrieval (GRAPH_PATTERNS.md pattern 20) ---
# The ml-service container: the cross-encoder reranker and the prompt-injection classifier.
# ML_SERVICE_URL=http://localhost:8083
# Model routing (specs/014, specs/015, GRAPH_PATTERNS pattern 68): choose a model tier per turn from rules over the message plus a label from the ML
# service's label set, and call that tier's gateway alias. OFF and inert by default. ROUTER_MODE=shadow makes and counts every decision
# (agent_model_route_tier_total{mode="shadow"}) but runs the turn on CHAT_MODEL, so you read what routing WOULD have spent before it spends anything; on acts.
# shadow/on refuse to start unless MEDIUM_CHAT_MODEL or STRONG_CHAT_MODEL names an alias different from CHAT_MODEL and from each other. A tier whose
# alias is empty does not exist: a decision for it steps down to the next tier below. Dev `chat-medium` is the same local 7B as `chat`; `chat-strong`
# is a LOCAL 14B (`make pull-strong-model`). ROUTER_ENABLED (the old switch) is refused if true; use ROUTER_MODE.
# MEDIUM_CHAT_MODEL=
# STRONG_CHAT_MODEL=
# ROUTER_MODE=off                     # off | shadow | on
# ROUTER_MAX_TIER=strong              # the ceiling: no turn is routed above it (local | medium | strong); one operator-wide value
# ROUTER_LABELS=true                  # ask the ML service for the message's topic (POST /v1/decide); false = rules only
# ROUTER_LONG_PROMPT_CHARS=1500       # the long_prompt rule fires at this length (>= 200)
# ROUTER_TIMEOUT_SECONDS=0.5          # the label call's deadline; a miss leaves the rules to decide, so routing never waits longer than this
# The ML service's own environment (docker/ml-service/ml_service/settings.py; set on the ml-service container, not in the app):
# ML_MODELS_ENABLED=                  # comma list of docker/ml-service/models.toml names to load; empty = the entries marked enabled
# ML_EMBED_MAX_ITEMS=256              # /v1/embeddings: more inputs than this is a 400, never truncated
# ML_EMBED_MAX_CHARS=8000             # /v1/embeddings: a longer input is a 400
# ML_EMBED_BATCH_SIZE=32              # texts per model pass
# ML_CLASSIFY_MAX_CHARS=4000          # /v1/decide: a longer `state` is a 413
# ML_CLASSIFY_DEADLINE_MS=250         # /v1/decide: a model slower than this hands the request to the fallback (it stays ready); the deadline is per model
# LABELSET_DIR=/app/labelsets         # where label sets (<name>.json, answered by POST /v1/decide) are read; mount your own (docker/ml-service/labelsets/README.md)
# ML_MODEL_RETRY_BASE_S=5             # a model that failed to load is retried after this, doubling...
# ML_MODEL_RETRY_MAX_S=300            # ...up to this cap
# SPARSE_MODEL=Qdrant/bm25            # local BM25 sparse-vector model (fastembed)
# HYBRID_PREFETCH_LIMIT=20            # candidates pulled per leg (dense, sparse) before fusion
# RERANK_TOP_K=5                      # results kept after the rerank

# --- Skills and subagents (patterns 45, 46) ---
# SKILLS_DIR=skills                   # relative to the working directory; the image ships it
# SKILLS_COLLECTION=skills            # separate Qdrant collection for skill_search (`make index-skills`)
# SKILLS_SEARCH_TOP_K=1               # 1 on purpose: with qwen2.5:3b even one distractor made it hedge
# SUBAGENTS_DIR=subagents
# SUBAGENT_TIMEOUT_SECONDS=45         # wall-clock cap on ONE nested subagent run

# --- Tenancy and memory ---
# DEFAULT_TENANT=ecorp                # the tenant scripts/seed.py stamps on sample documents
# MEMORY_RETENTION_DAYS=365           # an older memory is invisible at recall time

# --- Semantic cache (pattern 22) and Redis ---
# REDIS_URL=redis://localhost:6379
# SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.95   # cosine; a query must be nearly identical in meaning
# SEMANTIC_CACHE_TTL_SECONDS=3600
# REDIS_MAX_CONNECTIONS=300           # every queued SSE connection holds one for the whole turn

# --- Spend and time ceilings ---
# Local Ollama models carry a small SHADOW price in deploy/litellm/litellm-config.yaml (not a bill: it lets the meter and these caps see local
# usage), so a local turn costs a few millionths of a dollar and these ceilings stay far away; they bite once OPENAI_API_BASE is a paid provider.
# MAX_COST_USD_PER_TURN=0.5           # hard stop before the next tool/LLM call in one turn
# MAX_SUBAGENT_COST_USD_PER_RUN=0.15  # the only enforcement on one nested subagent call
# MAX_COST_USD_PER_TENANT_PER_DAY=20.0   # rolling 24h, against the usage events (one row per model call)
# MAX_COST_USD_PER_TENANT_PER_MONTH=0    # calendar month (UTC), resets on the 1st; 0 = no cap
# MAX_COST_USD_PER_PRINCIPAL_PER_DAY=0   # one person's rolling 24h inside their tenant; 0 = no cap
# MAX_COST_USD_PER_PRINCIPAL_PER_MONTH=0 # one person's calendar month; 0 = no cap
# REQUEST_TIMEOUT_SECONDS=60          # outermost wall-clock bound on one turn
# PRICING_REFRESH_SECONDS=3600        # how long a model price read from LiteLLM /model/info is trusted
# USAGE_EVENT_RETENTION_DAYS=400       # `make usage-events-sweep` deletes older usage events; floor 35 (the caps and the reconciliation read them). The wallet is never touched
# BUDGET_POLICY_REFRESH_SECONDS=30     # how long per-tenant/per-person limit overrides are cached per process; 0 = off
# BUDGET_CHECK_FAILURE_POLICY=open    # open | closed — what the tenant allowance does when it cannot read the spend (the usage events)
# USAGE_EVENTS_ENABLED=true           # per-call usage events (postgres-init/19-usage-events.sql). The dollar caps sum them, so `false` is REFUSED at startup (every cap would read $0): leave it unset
# UNPRICED_MODEL_POLICY=allow         # allow | block — block refuses turns (and subagent runs) on a model LiteLLM cannot price
# CREDITS_PER_USD=                    # credits per US dollar of model cost. NO default: a price is your decision. Unset = credits are off for the whole deployment (nothing rated, debited, gated or shown). e.g. 1000 makes 1 credit = $0.001. Apply postgres-init/21-usage-event-credits.sql BEFORE setting it. At most 6 decimal places
# MARKUP=1                            # multiplier on cost when pricing a call in credits (1 = at cost, 1.5 = cost + 50%); only used with CREDITS_PER_USD
# CREDITS_ENFORCEMENT=false           # true refuses a turn (insufficient_credits) for a tenant with a wallet whose available credits, less in-flight holds, are not positive. Needs CREDITS_PER_USD. False with a rate set still debits wallets ("shadow mode")
# CREDIT_CHECK_FAILURE_POLICY=open    # open | closed — what the credit gate does when it cannot read the wallet (only consulted when enforcing); open serves and alerts CreditGateUnenforced
# BILLING_PROVIDERS=                  # comma-separated payment providers whose webhooks are accepted at POST /billing/webhooks/{name} (empty = none). Each needs a secret below or the process refuses to start. Set it the SAME in the API, the agent workers and the export worker: a usage event is queued for export only by a process that has the provider enabled. "fake" is the development/test adapter: never in production
# BILLING_WEBHOOK_SECRETS={}          # JSON {"provider": "signing secret"}; keep it in .env, never in the repo
# BILLING_WEBHOOK_MAX_BODY_BYTES=262144   # a larger webhook body is refused (413) before it is read
# BILLING_WEBHOOK_RATE_LIMIT_PER_MINUTE=600   # per source address, on the webhook route only
# BILLING_WEBHOOK_MAX_ATTEMPTS=5      # failed applies of one event before it is quarantined (alert BillingWebhookQuarantined) instead of retried forever
# BILLING_REFUND_HOLD_HOURS=24        # how long a refund that arrives before its purchase is held (provider retries) before it is quarantined
# BILLING_INBOX_RETENTION_DAYS=400    # how long `make billing-inbox-sweep` keeps applied/ignored webhook rows (floor 30)
# BILLING_USAGE_EVENT_RETENTION_DAYS=400   # how long `make billing-usage-sweep` keeps the billing package's usage events (floor 35); an event whose export never finished is kept
# BILLING_EXPORT_BATCH_SIZE=100       # usage events sent to a provider per worker pass (`make billing-export-worker`)
# BILLING_EXPORT_INTERVAL_SECONDS=30  # how often the export worker looks for due events
# BILLING_EXPORT_MAX_ATTEMPTS=10      # retryable failures of one event before it is given up on (alert UsageExportFailed)
# BILLING_EXPORT_BACKOFF_BASE_SECONDS=30   # after the k-th failed attempt an event waits min(base * 2**(k-1), cap)
# BILLING_EXPORT_BACKOFF_CAP_SECONDS=21600 # the longest a retry ever waits (6 hours)
# USAGE_RECONCILE_TOLERANCE_USD=0.01  # `make usage-reconcile` (the meter against the LLM gateway's spend log; was CREDIT_RECONCILE_*, which is still accepted): a per-tenant-per-day difference is drift only above the LARGER of this and the percentage below
# USAGE_RECONCILE_TOLERANCE_PCT=1     # percent of the larger of the two figures compared (absorbs rounding differences on a busy tenant)
# USAGE_RECONCILE_SETTLE_SECONDS=900  # leave the newest traffic out of a run: the gateway writes its spend log in batches, so the newest calls are in the events first. Keep above REQUEST_TIMEOUT_SECONDS plus the gateway's batch interval
# CREDIT_RECONCILE_SETTLE_SECONDS=900 # the same for `make credit-reconcile` (the billing package's wallet check: was every recorded usage charged?)
# USAGE_RECONCILE_LOOKBACK_DAYS=2     # whole UTC days each gateway run re-reads (1-35); the gateway is asked for every spend-log row in the window
# CREDIT_RECONCILE_LOOKBACK_DAYS=2    # whole UTC days the wallet check re-reads (1-35)
# USAGE_RECONCILE_INTERVAL_SECONDS=21600  # how often `make usage-reconcile-worker` runs a pass
# CREDIT_RECONCILE_INTERVAL_SECONDS=21600  # how often `make credit-reconcile-worker` runs a pass
# USAGE_RECONCILE_GATEWAY_MAX_PAGES=200    # ceiling on gateway pages (1000 rows each) per run; past it the gateway comparison is reported INCOMPLETE, never as a short sum
# BILLING_EXPORT_MAX_AGE_DAYS=30      # an event still unsent after this is expired, counted and alerted (max 34: Stripe rejects events older than 35 days)
# BILLING_EXPORT_CALL_TIMEOUT_SECONDS=30  # the deadline for one call to a provider (the worker holds the batch's locks while it waits)

# --- Payment providers: Stripe and Polar credentials (specs/010 T029) ---
# The STRIPE and POLAR adapters are built: put `stripe` and/or `polar` in BILLING_PROVIDERS (each with its signing secret in
# BILLING_WEBHOOK_SECRETS) and set its API credential below to let it create checkouts. A PAYPAL adapter is NOT BUILT, and an
# unregistered name in BILLING_PROVIDERS makes the API refuse to start.
# Use SANDBOX credentials (Stripe: a sandbox's keys; Polar: a token created at https://sandbox.polar.sh).
# Keep every value in .env, never in the repo. A webhook signing secret is NOT a separate variable: it goes in
# BILLING_WEBHOOK_SECRETS above, per provider, as {"stripe": "whsec_...", "polar": "..."}.
# STRIPE_API_KEY=                     # a server-side key from the sandbox's API keys page: restricted (rk_test_) is recommended over secret (sk_test_). A publishable key (pk_) is refused. Blank = not set (webhooks are still verified; a checkout is refused)
# POLAR_ACCESS_TOKEN=                 # an Organization Access Token from the Polar SANDBOX organization (a production token does not work there). Blank = not set (webhooks are still verified; a checkout is refused)
# POLAR_ENVIRONMENT=sandbox           # sandbox | production: https://sandbox-api.polar.sh/v1 or https://api.polar.sh/v1. Keep sandbox until you are ready to take real money

# --- Queue and workers (patterns 43, 44; WORKER_CONCURRENCY.md) ---
# AGENT_WORKER_MAX_CONCURRENCY=10     # concurrent turns per agent-worker process
# INGEST_WORKER_MAX_CONCURRENCY=10    # concurrent ingest jobs per ingest-worker process
# WORKER_RECLAIM_INTERVAL_SECONDS=60  # how often each worker polls for entries a dead worker abandoned
# AGENT_WORKER_RECLAIM_IDLE_SECONDS=240    # unacked this long = presumed dead; keep above the longest live job
# INGEST_WORKER_RECLAIM_IDLE_SECONDS=900   # ingest has no wall-clock timeout, so this is generous
# MAX_AUTO_RECLAIM_RETRIES=1          # re-publishes of one reclaimed job before it is dead-lettered
# CHAT_SUBMIT_DEDUP_TTL_SECONDS=10    # an identical resubmission inside this window reuses the first attempt
# CHAT_FIRST_RESPONSE_DEADLINE_SECONDS=30     # wait for the FIRST event of a queued chat job, not the whole turn
# INGEST_FIRST_RESPONSE_DEADLINE_SECONDS=30   # same, for ingest jobs

# --- API protection and uploads ---
# RATE_LIMIT_PER_MINUTE=30            # per tenant, kept in Redis so it holds across processes
# CORS_ALLOWED_ORIGINS=*              # fine for the local demo; narrow it for a real deployment (deploy/env/prod.env.example)
# MAX_UPLOAD_SIZE_MB=25               # per file, enforced before any object-store write
# MAX_UPLOAD_FILES_PER_REQUEST=5

# --- Object storage for uploads (docker-compose's `minio` service) ---
# The access/secret keys are MinIO's own local defaults — set real ones in .env.prod.
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=ingest-uploads
# MINIO_SECURE=false                  # plain http for local compose; true for a real deployment

# --- Strix (`make strix`, `make strix-app`; the strix.yml workflow reads repo secrets of the same names instead) ---
# An autonomous pentest agent that runs outside this app and needs a CLOUD model, not the local Ollama. The Makefile loads exactly
# these five names from here (not the rest of this file) and unsets OPENAI_API_BASE and its aliases for the run: Strix would
# otherwise send the scan to the local LiteLLM proxy. The model is in LiteLLM's format; a Google AI Studio key (GOOGLE_API_KEY
# above) goes in LLM_API_KEY and needs the `gemini/` prefix, since a bare name is routed to Vertex AI. Leave LLM_API_BASE unset for a hosted provider.
# EXA_API_KEY and PERPLEXITY_API_KEY are optional: they give the agent web search while it works (one of them is enough).
# A value is read literally, not evaluated by a shell: optional matching quotes, no `$VAR`, no trailing `# comment`.
# STRIX_LLM=gemini/gemini-3.6-flash
# LLM_API_KEY=
# LLM_API_BASE=
# EXA_API_KEY=
# PERPLEXITY_API_KEY=
