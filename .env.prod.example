# Template for /opt/agent-core-demo/.env on the droplet — copy this there
# and fill in real values ONCE, by hand, over SSH (infra/README.md's
# first-time-setup section). Never committed with real values, and never
# written or touched by .github/workflows/deploy.yml: that workflow only
# ships code/compose/config, deliberately not secrets (see
# docker-compose.prod.yml's own header comment).

# --- Container images (.github/workflows/deploy.yml builds+pushes these
# to GHCR; IMAGE_TAG itself is passed by that workflow at deploy time, not
# stored here) — lowercase, must match your actual GitHub org/user + repo. ---
APP_IMAGE=ghcr.io/your-gh-username/agent-core-demo
ML_IMAGE=ghcr.io/your-gh-username/agent-core-demo-ml-service

# --- Postgres (shared by litellm/checkpointer/appdata — see
# docker-compose.prod.yml's postgres service comment on why the username
# stays "langfuse") ---
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- LiteLLM proxy ---
# Generate: openssl rand -hex 24 (or -hex 32) — this becomes the value
# app callers must send as OPENAI_API_KEY; app/api and the workers get it
# automatically via docker-compose.prod.yml's *app-env anchor.
LITELLM_MASTER_KEY=
LITELLM_UI_USERNAME=admin
# Generate: openssl rand -hex 16
LITELLM_UI_PASSWORD=

# --- Upstream LLM (litellm-config.prod.yaml) — any OpenAI-compatible
# endpoint. Example below targets OpenAI directly; swap for Anthropic's
# OpenAI-compatible endpoint, a hosted vLLM/Ollama instance, etc. ---
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=openai/gpt-4o-mini
LLM_EMBED_MODEL=openai/text-embedding-3-small

# --- Object storage — DigitalOcean Spaces by default (S3-compatible; see
# docker-compose.prod.yml's header on why no self-hosted MinIO container
# runs here). Create a Space + access key at
# https://cloud.digitalocean.com/spaces ---
MINIO_ENDPOINT=nyc3.digitaloceanspaces.com
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=agent-core-demo-uploads
MINIO_SECURE=true

# --- Reverse proxy / TLS (Caddyfile) — leave empty to serve plain HTTP
# over the droplet's reserved IP instead of a real domain+cert. ---
DOMAIN_NAME=

# --- Observability droplet (docker-compose.prod.yml's `alloy` service) —
# the SEPARATE, smaller droplet infra/terraform provisions
# (digitalocean_droplet.observability). Get the value from
# `terraform output observability_private_ipv4` after `terraform apply`;
# it's a private DO VPC IP, never reachable from the public internet, so
# these are safe to leave unencrypted. Leaving either empty just means this
# droplet's metrics/logs have nowhere to go — the app itself is unaffected. ---
OBS_COLLECTOR_ENDPOINT=http://<observability_private_ipv4>:4318
LOKI_PUSH_HOST=<observability_private_ipv4>:3100

# --- CORS — a real deployment narrows this from the dev default ("*");
# set it to your actual frontend origin(s), comma-separated. ---
CORS_ALLOWED_ORIGINS=https://your-domain.example.com

# --- Safety budgets — dev defaults are fine to start; see
# app/core/config.py for what each one means. Non-zero here (unlike the
# local Ollama stack) since LLM_API_BASE above is now a real paid
# provider. ---
RATE_LIMIT_PER_MINUTE=30
MAX_COST_USD_PER_TURN=0.50
MAX_COST_USD_PER_TENANT_PER_DAY=20.0

# --- Optional integrations — leave empty to skip (each degrades
# gracefully, see app/core/config.py's own comments per field) ---
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
CRAWL4AI_SERVER_URL=
CRAWL4AI_API_TOKEN=
OPENSANDBOX_MCP_DOMAIN=
OPENSANDBOX_API_KEY=
