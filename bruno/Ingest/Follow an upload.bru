meta {
  name: Follow an upload
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/ingest/stream/{{jobId}}
  body: none
  auth: inherit
}

headers {
  Accept: text/event-stream
}

assert {
  res.status: eq 200
}

tests {
  test("the job finished", function () {
    expect(res.getBody()).to.include('"type": "done"');
  });
}

docs {
  Progress of the job `Upload a document` started: `started`, `progress`, then `done` or `error`.
}
