meta {
  name: List sessions
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/chat/sessions
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("lists the thread just used, newest first", function () {
    expect(res.getBody().map((s) => s.thread_id)).to.include(bru.getVar("threadId"));
  });
}

docs {
  This caller's own threads for the `X-Domain`, never another person's.
}
