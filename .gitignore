.env
.venv/
__pycache__/
*.pyc
eval_runs/
var/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Node (promptfoo — see promptfoo/ and package.json)
node_modules/
.promptfoo/
promptfoo/prompts/
# `make promptfoo-redteam`'s working copy — `redteam run` rewrites its
# --config file in place, so this is a throwaway copy of redteam.yaml, never
# the source of truth.
promptfoo/.redteam-run-scratch.yaml

# garak (see garak/) scan reports/state — regenerated per run, not source
garak/.garak/
garak_runs/
*.report.jsonl
*.report.html
*.hitlog.jsonl

# locust (see loadtest/) — CSV/HTML reports from `make loadtest-headless`
loadtest/results/

# strix (see `make strix`/`make strix-app`, .github/workflows/strix.yml) —
# per-run findings/agent-trace state written to the repo root it's invoked
# from; `~/.strix/cli-config.json` (the LLM auth config) lives outside the
# repo entirely, nothing to ignore for that part
strix_runs/

