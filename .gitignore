.env
CREDENTIALS.local.md
.venv/
__pycache__/
*.pyc
eval_runs/
var/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Node (promptfoo — see promptfoo/ and package.json)
node_modules/
.promptfoo/
promptfoo/prompts/
# `make promptfoo-redteam`'s working copy — `redteam run` rewrites its
# --config file in place, so this is a throwaway copy of redteam.yaml, never
# the source of truth.
promptfoo/.redteam-run-scratch.yaml

# garak (see garak/) scan reports/state — regenerated per run, not source
garak/.garak/
garak_runs/
*.report.jsonl
*.report.html
*.hitlog.jsonl

# locust (see loadtest/) — CSV/HTML reports from `make loadtest-headless`/`make loadtest-queued-headless`
loadtest/results/
loadtest/results-queued/

# strix (see `make strix`/`make strix-app`, .github/workflows/strix.yml) —
# per-run findings/agent-trace state written to the repo root it's invoked
# from; `~/.strix/cli-config.json` (the LLM auth config) lives outside the
# repo entirely, nothing to ignore for that part
strix_runs/

# sonar-scanner (make sonar-scan / CI's `sonarqube` job) — local scan
# working files, regenerated every run
.scannerwork/
.sonar/

# Terraform (infra/terraform, see infra/README.md) — local state and any
# real tfvars; terraform.tfvars.example and .terraform.lock.hcl (both
# meant to be committed) are unaffected since neither matches these globs.
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfplan
infra/terraform/terraform.tfvars
infra/terraform/*.auto.tfvars
infra/terraform/crash.log

# Production secrets — must exist only on the droplet itself, never in this
# repo (see docker-compose.prod.yml's own header comment); .env.prod.example
# is the committed template and stays unaffected by this glob.
.env.prod

