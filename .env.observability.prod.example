# Template for /opt/agent-core-observability/.env on the SEPARATE
# observability droplet (infra/terraform's digitalocean_droplet.observability)
# — copy this there and fill in real values ONCE, by hand, over SSH, same
# "operator sets .env, CI never touches secrets" posture as
# .env.prod.example (see docker-compose.observability.prod.yml's own
# header).

# --- Grafana admin login — this instance is reachable from the public
# internet via Caddy (Caddyfile.observability), so a real password is
# required (unlike docker-compose.observability.yml's dev-only
# admin/admin + anonymous-viewer defaults). ---
# Generate: openssl rand -hex 24
GRAFANA_ADMIN_PASSWORD=

# --- Reverse proxy / TLS (Caddyfile.observability) — leave empty to serve
# plain HTTP over this droplet's own reserved IP instead of a real
# domain+cert. If set, also set infra/terraform's obs_domain_name to match
# (informational there; this is what Caddy actually acts on). ---
OBS_DOMAIN_NAME=
